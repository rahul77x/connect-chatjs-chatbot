# ========================================================
# Amazon Connect Custom ChatJS - Environment Configuration
# ========================================================

# Port for local web server
PORT=3000

# AWS Region where your Amazon Connect instance is deployed (e.g. us-east-1, us-west-2, eu-central-1, ap-southeast-2)
AWS_REGION=us-east-1

# Your Amazon Connect Instance ID (Found in AWS Console -> Amazon Connect -> Instances -> Overview)
# Example: 12345678-1234-1234-1234-1234567890ab
CONNECT_INSTANCE_ID=

# The Inbound Contact Flow ID that handles customer chats (Found in Connect -> Routing -> Contact Flows)
# Make sure this flow has a "Store customer input" or Lex Bot / Bedrock Agent block
# Example: abcdef12-3456-789a-bcde-f1234567890a
CONNECT_CONTACT_FLOW_ID=

# AWS Credentials with `connect:StartChatContact` permission (Optional if running with IAM role or AWS CLI profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (if using temporary credentials)

